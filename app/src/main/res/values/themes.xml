<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ColdCat.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ice_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/ice</item>
        <item name="colorSurface">@color/card</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.ColdCat" parent="Theme.ColdCat.Base" />

    <style name="Theme.ColdCat.Addons" parent="Theme.ColdCat" />

    <style name="Widget.ColdCat.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:tint">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
